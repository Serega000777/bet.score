APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://bet_score:bet_score@postgres:5432/bet_score
REDIS_URL=redis://redis:6379/0
READINESS_TIMEOUT_SECONDS=2
LIVE_HEARTBEAT_SECONDS=20
LIVE_MAX_CONNECTIONS=1000
LIVE_MAX_CONNECTIONS_PER_EVENT=200
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_SECONDS=30
OUTBOX_POLL_SECONDS=1
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_TTL_SECONDS=600
SESSION_COOKIE_NAME=bet_score_session
SESSION_TTL_DAYS=30
OPENAI_API_KEY=
